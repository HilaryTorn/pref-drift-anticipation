# Multi-language verify box for the LCB SFT arms (go + php + csharp).
#
# NOT an AWS image, despite living in .aws/ -- it sits next to Dockerfile.lcb-verifier because that
# is the sibling recipe and the two must stay in step on toolchain versions. This one runs on the
# LAN box, esprimo@fujitsuhome.lan, which is free; the CodeBuild path costs money and the hosted-CI
# path was removed in 9f651b8 as unreliable.
#
# Supersedes the Go-only Dockerfile that previously existed only on the box. Keep this file in the
# repo: the box copy is not backed up, and its build/run commands were once recoverable only from
# shell history, which turned out to be empty.
#
#   build (needs network, from the build context holding requirements-multilcb-gen.txt):
#     sudo docker build -f Dockerfile.multi -t lcb-verify:multi .
#
#   run (grading; --network none is deliberate, the cache is complete before evaluation):
#     sudo docker run --rm --network none -u 1000:1000 \
#       -e HOME=/cache -e XDG_CACHE_HOME=/cache -e HF_HOME=/cache/hf \
#       --ulimit stack=8589934592:8589934592 \
#       -v ~/container/lcb-verify/repo:/work -v ~/container/lcb-verify/cache:/cache \
#       -w /work lcb-verify:multi \
#       python3 scripts/score_multilcb.py --model_key <key> --languages <php|csharp|go> \
#         --release_version v6 --n 1 --evaluate_only --diagnose --num_process_evaluate 8
#
# The --ulimit stack is what .aws/run-lcb-verifier.sh needs under CodeBuild: multi-lcb raises a
# stack rlimit, and that same rlimit is why Go grading dies in preexec_fn on macOS.
#
# score_multilcb.py gates each language on the binaries in its TOOLCHAIN_BINARIES table:
# go -> `go`, php -> `php`, csharp -> `mcs` + `mono`. Rust is deliberately NOT here -- it grades on
# the Mac, which has rustc, so the box does not need it.
#
# php-cli and mono-devel are the same two Debian packages Dockerfile.lcb-verifier installs, and this
# base is the same Debian release (bookworm), so the compilers match the ones that graded the
# php/csharp teacher pools: mono 6.8.0.105+dfsg-3.3+deb12u1, PHP 8.2.33, verified 2026-09-04. Do not
# swap in conda-forge mono: docs/multilcb-eval.md notes a different mono can move the scores, and
# conda-forge has no mono for linux-aarch64 at all.
#
# Check the toolchains with upstream's own suite, not `which php` -- C# needs mcs to compile AND
# mono to run, and a half-install surfaces only as a wall of BuildFailed:
#     python3 -m pytest -q tests/tests_plangs/test_php.py tests/tests_plangs/test_csharp.py
#
# Nothing is installed on the host. The repo and dataset are bind-mounted at /work; the image is
# disposable (`docker rmi lcb-verify:multi`).

FROM golang:1.24-bookworm

RUN apt-get update && apt-get install -y --no-install-recommends \
      python3 python3-venv ca-certificates \
      php-cli \
      mono-devel \
    && rm -rf /var/lib/apt/lists/*

# PEP 668 marks Debian's python as externally managed, so pip needs a venv rather than --break-system-packages.
RUN python3 -m venv /opt/venv
ENV PATH=/opt/venv/bin:$PATH

COPY requirements-multilcb-gen.txt /tmp/
RUN pip install --no-cache-dir -r /tmp/requirements-multilcb-gen.txt pytest

# The container runs as the invoking host UID so that files written to the bind mount stay owned by
# esprimo. That leaves $HOME unwritable, and Go refuses to build without a writable cache, so point
# its caches at /tmp. GOTOOLCHAIN=local stops Go fetching a different toolchain over the network,
# which matters because the grading run is meant to work with --network none.
ENV GOCACHE=/tmp/gocache GOPATH=/tmp/gopath GOTOOLCHAIN=local

# mono wants a writable home for its certificate store and per-user state, for the same UID reason.
# The run command already passes HOME=/cache with /cache bind-mounted, so this is only the fallback
# for a run that forgets it.
ENV XDG_DATA_HOME=/tmp/mono-data MONO_REGISTRY_PATH=/tmp/mono-registry

WORKDIR /work
